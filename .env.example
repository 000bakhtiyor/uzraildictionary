APP_PORT=3000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=uzraildictionary
DB_SYNCHRONIZE=false

# Min 32 characters required
JWT_SECRET=change-this-to-a-random-32-plus-character-string
JWT_EXPIRES_IN=15m

ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_FULL_NAME=System Admin

# Gmail SMTP — use App Password (not account password)
# Enable: Google Account → Security → 2FA → App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=xxxx_xxxx_xxxx_xxxx
SMTP_FROM="UzRail Dictionary <your_email@gmail.com>"
